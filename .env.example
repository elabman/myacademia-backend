# =====================================================
# Server
# =====================================================
NODE_ENV=development
PORT=7000   # on a Mac use another port (e.g. 4000): AirPlay already listens on 5000 and 7000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:7000

# =====================================================
# Database (MySQL 8 or MariaDB 10.4+ / XAMPP - db_myacademia)
# =====================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=nowordpass
DB_NAME=db_myacademia
DB_CONNECTION_LIMIT=10

# =====================================================
# JWT
# =====================================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=db-myacademia-api

# =====================================================
# Bcrypt
# =====================================================
BCRYPT_SALT_ROUNDS=12

# =====================================================
# Password reset
# =====================================================
RESET_TOKEN_EXPIRES_MIN=30

# =====================================================
# Rate limiting (auth endpoints)
# =====================================================
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=10

# =====================================================
# File uploads
# =====================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# =====================================================
# Outgoing email (SMTP). Leave SMTP_HOST empty to keep email off.
# Gmail: host smtp.gmail.com, port 465 + SECURE=true (or 587 + SECURE=false),
#   user = the full Gmail address, pass = a 16-character APP PASSWORD (not the
#   normal Gmail password; needs 2-Step Verification). MAIL_FROM must be that address.
# Test it with:  npm run mail:test -- someone@example.com
# =====================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

